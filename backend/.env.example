# MongoDB — replica set requerido para transacciones multi-doc
MONGO_URI=mongodb://localhost:27017/management_tickets?replicaSet=rs0

# JWT — generar secret aleatorio 64+ chars (ej: openssl rand -base64 64)
JWT_SECRET=change-this-to-a-secure-random-base64-string-at-least-64-chars-long
JWT_ACCESS_EXPIRATION_MIN=15
JWT_REFRESH_EXPIRATION_DAYS=7

# SMTP — Gmail requiere "App Password", NO contraseña normal
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=app-password-16-chars
MAIL_FROM=no-reply@sistemasintegrados.co

# Reset password
PASSWORD_RESET_TOKEN_EXPIRATION_MIN=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Auth lockout
AUTH_MAX_FAILED_ATTEMPTS=5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
